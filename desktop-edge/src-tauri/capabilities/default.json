{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Phase 1 capability — core defaults plus an explicit allowlist of the app's own IPC commands (T11/H5). Every custom command is named here; nothing outside this list is reachable from the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-core-ping",
    "allow-voice-smoke",
    "allow-clipboard-smoke",
    "allow-mic-smoke",
    "allow-load-edge-settings",
    "allow-save-edge-settings",
    "allow-edge-settings-path",
    "allow-presence-status",
    "allow-presence-set-mode",
    "allow-presence-set-signals",
    "allow-presence-set-reduced-motion",
    "allow-presence-apply-reduced-motion",
    "allow-presence-current-modes",
    "allow-presence-set-palette",
    "allow-presence-set-ring-wanted",
    "allow-presence-set-quality-tier",
    "allow-presence-set-interactive",
    "allow-presence-mic-status",
    "allow-presence-mic-start",
    "allow-presence-mic-stop",
    "allow-assistant-think",
    "allow-assistant-think-stream",
    "allow-assistant-tool-ping",
    "allow-assistant-notify-inbound",
    "allow-assistant-backend-status",
    "allow-assistant-test-backend",
    "allow-assistant-save-backend",
    "allow-assistant-audit-tail",
    "allow-assistant-audit-verify",
    "allow-assistant-diagnostics-bundle",
    "allow-assistant-probe-backend",
    "allow-presence-log-tail",
    "allow-reveal-path-in-file-manager"
  ]
}
